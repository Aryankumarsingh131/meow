{
  "openapi": "3.1.0",
  "info": {
    "title": "JalSakshi API (v1 contracts only)",
    "description": "Contract-only surface generated for T05. Not a running backend - see docs/agent-workflow/handoff-T05.md.",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/sync/push": {
      "post": {
        "summary": "Idempotent sample event batch push",
        "operationId": "sync_push_v1_sync_push_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cases/{case_id}/commands": {
      "post": {
        "summary": "Role-checked, idempotent case command",
        "operationId": "case_command_v1_cases__case_id__commands_post",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/AssignCommand"
                  },
                  {
                    "$ref": "#/components/schemas/ReferToLabCommand"
                  },
                  {
                    "$ref": "#/components/schemas/RecordActionCommand"
                  },
                  {
                    "$ref": "#/components/schemas/AcceptActionCommand"
                  },
                  {
                    "$ref": "#/components/schemas/LinkRetestCommand"
                  },
                  {
                    "$ref": "#/components/schemas/RecordCommunicationCommand"
                  },
                  {
                    "$ref": "#/components/schemas/RequestClosureCommand"
                  },
                  {
                    "$ref": "#/components/schemas/CloseCommand"
                  },
                  {
                    "$ref": "#/components/schemas/ReopenCommand"
                  },
                  {
                    "$ref": "#/components/schemas/DismissCommand"
                  }
                ],
                "discriminator": {
                  "propertyName": "type",
                  "mapping": {
                    "assign": "#/components/schemas/AssignCommand",
                    "refer_to_lab": "#/components/schemas/ReferToLabCommand",
                    "record_action": "#/components/schemas/RecordActionCommand",
                    "accept_action": "#/components/schemas/AcceptActionCommand",
                    "link_retest": "#/components/schemas/LinkRetestCommand",
                    "record_communication": "#/components/schemas/RecordCommunicationCommand",
                    "request_closure": "#/components/schemas/RequestClosureCommand",
                    "close": "#/components/schemas/CloseCommand",
                    "reopen": "#/components/schemas/ReopenCommand",
                    "dismiss": "#/components/schemas/DismissCommand"
                  }
                },
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Conflict"
          }
        }
      }
    }
  },
