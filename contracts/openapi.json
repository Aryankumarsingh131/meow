      "TimingIndeterminate": {
        "properties": {
          "state": {
            "type": "string",
            "const": "indeterminate",
            "title": "State"
          },
          "reason": {
            "type": "string",
            "enum": [
              "reboot",
              "clock_rollback",
              "clock_disagreement",
              "monotonic_regression",
              "read_window_malformed"
            ],
            "title": "Reason"
          },
          "valid": {
            "type": "boolean",
            "const": false,
            "title": "Valid",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state",
          "reason"
        ],
        "title": "TimingIndeterminate",
        "description": "Elapsed time could NOT be established (reboot, clock change, ...).\n\nDeliberately has NO `elapsed_ms`. The previous v1 shape required one, so\na rebooted test could only be recorded by inventing a number\n(`elapsed_ms=0`) \u2014 fabricated precision, forbidden by AGENTS.md. Absence of\nthe field is the only honest representation of \"unknown\"."
      },
      "TimingMeasured": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "preparing",
              "waiting",
              "in_window",
              "late",
              "expired"
            ],
            "title": "State"
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Elapsed Ms"
          },
          "valid": {
            "type": "boolean",
            "title": "Valid"
          }
        },
        "type": "object",
        "required": [
          "state",
          "elapsed_ms",
          "valid"
        ],
        "title": "TimingMeasured",
        "description": "Elapsed time was genuinely measured on a trustworthy clock.\n\n`valid` is not free for the client to assert: it must equal\n`state == \"in_window\"`, enforced below. protocol-schema.md makes the\nin-window case the ONLY valid one, so a client cannot send\n`state=\"expired\", valid=true` and have the server believe it."
      }
    }
  }
