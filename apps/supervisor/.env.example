# Copy to .env. Values in .env are local and ignored by Git.
JALSAKSHI_ENVIRONMENT=development
JALSAKSHI_TENANT_DATA_MODE=synthetic
# The JalSakshi API (services/api). Default: the local API that
# tools/dev_tunnel.sh starts on :8000. Any non-local URL must be HTTPS, e.g.
# the ngrok URL. The dashboard needs no Supabase keys or database URL.
JALSAKSHI_API_URL=http://127.0.0.1:8000
# Required in production: 32+ random chars, e.g. `openssl rand -hex 32`. Seals session cookies.
JALSAKSHI_SESSION_SECRET=
