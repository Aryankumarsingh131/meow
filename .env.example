# Template. Copy to `.env` and fill in real values. `.env` is gitignored.
# Never commit real credentials, and never paste them into a chat, an issue,
# a log or a handoff (AGENTS.md).

JALSAKSHI_ENVIRONMENT=development
# synthetic | research | operational.
# config.py refuses to start production unless this is `operational`, so
# synthetic data can never be served from a production environment.
JALSAKSHI_TENANT_DATA_MODE=synthetic

# Postgres/Supabase. Form: postgresql://USER:PASSWORD@HOST:5432/postgres
# Supabase gives this under Settings -> Database -> Connection string.
JALSAKSHI_DATABASE_URL=postgresql://postgres:REPLACE_ME@db.REPLACE_ME.supabase.co:5432/postgres

JALSAKSHI_SUPABASE_URL=https://REPLACE_ME.supabase.co
# Publishable/anon key. Client-visible by design, but still not committed.
# The service_role key must NEVER be placed here or used from the app.
JALSAKSHI_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
